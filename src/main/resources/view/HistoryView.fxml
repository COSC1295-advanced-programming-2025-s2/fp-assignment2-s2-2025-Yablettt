<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.voluntrack.controller.HistoryController">
   <center>
      <TableView fx:id="historyTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="regIdCol" prefWidth="75.0" text="Reg Code" />
          <TableColumn fx:id="dateTimeCol" prefWidth="75.0" text="Date/Time" />
            <TableColumn fx:id="titleCol" prefWidth="75.0" text="Title" />
            <TableColumn fx:id="locationCol" prefWidth="75.0" text="Location" />
            <TableColumn fx:id="dayCol" prefWidth="75.0" text="Day" />
            <TableColumn fx:id="slotsCol" prefWidth="75.0" text="Slots" />
            <TableColumn fx:id="hoursCol" prefWidth="75.0" text="Hours" />
            <TableColumn fx:id="totalCol" prefWidth="75.0" text="Total" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="16.0" right="215.0" top="16.0" />
         </padding>
         <children>
            <Button mnemonicParsing="false" onAction="#onBackToDashboard" text="Dashboard" />
            <Button mnemonicParsing="false" onAction="#onExport" text="Export" />
            <Button mnemonicParsing="false" onAction="#onOpenCart" text="Cart" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
